{
	"id":"spinalgauss",  # this id must match what's in the spreadsheet
	"specClass":"projectile",
	"type":"BALLISTIC",
	"size":"LARGE",
	"displayArcRadius":1200,
	"turretSprite":"graphics/weapons/SpinalGauss.png",
	"turretGlowSprite":"graphics/weapons/SpinalGauss_glow.png",
	"hardpointSprite":"graphics/weapons/SpinalGauss.png",
	"hardpointGlowSprite":"graphics/weapons/SpinalGauss_glow.png",
	"glowColor":[125,200,255,255],
	"turretOffsets":[25, 0],
	"turretAngleOffsets":[0],
	"hardpointOffsets":[35, 0],
	"hardpointAngleOffsets":[0],
	"barrelMode":"ALTERNATING", # or LINKED.  whether barrels fire at the same time or alternate.
