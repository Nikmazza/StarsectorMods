{
	"id":"asm_flechette_shot",
	"specClass":"missile",	
	"missileType":"ROCKET",
	"sprite":"graphics/missiles/flechette_med.png",
	"onFireEffect":"data.scripts.asm.weapons.VoltaicFlechetteOnFire",
	"onHitEffect":"data.scripts.asm.weapons.VoltaicFlechetteOnHit",
	"size":[8,4],	
	"center":[4,2],
	"collisionRadius":30,
	"collisionClass":"MISSILE_FF",
	#"explosionColor":[200,200,150,180],
	"explosionColor":[0,0,0,0],
	"explosionRadius":30, # purely visual
	"fizzleOnReachingWeaponRange":true,
	"dudProbabilityOnFlameout":0,
	"useHitGlowWhenDestroyed":true,
	"flameoutTime":0.1, # fadeout duration
	"armingTime":0,
	"noEngineGlowTime":0.1, # time spent without the engine glow being rendered
	"fadeTime":0.1, # fadeout duration
	"behaviorSpec":{"behavior":"PROXIMITY_FUSE",
					"range":30,
					"explosionSpec":{"duration":0.1f,
									 "radius":60,
									 "coreRadius":30,
									 "collisionClass":PROJECTILE_FF,
									 "collisionClassByFighter":PROJECTILE_FIGHTER,
									 "particleSizeMin":3.0,
									 "particleSizeRange":3.0,
									 "particleDuration":0,
									 "particleCount":0,
									 "particleColor":[200,200,150,175],
									 "sound":"voltaic_discharge_fire"},
					},
	"engineSpec":{"turnAcc":0,
				  "turnRate":0,
				  "acc":2000,
				  "dec":2000},
	"engineSlots":[{"id":"ES1",
					"loc":[-4, 0],
				    #"style":"TORPEDO",
				    "style":"CUSTOM",
					"styleSpec":{
						"mode":"QUAD_STRIP", # PARTICLES or QUAD_STRIP, determines which params are used
						"engineColor":[200,200,150,255],
						"contrailDuration":1,
						"contrailWidthMult":1.5,
						"contrailWidthAddedFractionAtEnd":1,  # can be negative. makes trail spread out/narrow at the end
						"contrailMinSeg":5, # min segment length, in pixels
						"contrailMaxSpeedMult":0f,
						"contrailAngularVelocityMult":0.5f,
						"contrailSpawnDistMult":0f, # how far away from engine it starts
						"contrailColor":[200,200,150,50],
						"glowSizeMult":2.0,
						"glowAlternateColor":[125,100,0,255],
						"type":"SMOKE" # GLOW or SMOKE; additive or regular blend mode
					},
				    "width":4.0,
				    "length":10.0,
				    "angle":180.0}]
}